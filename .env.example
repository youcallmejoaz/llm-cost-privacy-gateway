# Copy to .env and edit. Never commit .env.

# 1 = run with zero API keys using recorded mock replies (default). 0 = call real providers.
DEMO_MODE=1

# Gateway HTTP port and bind address.
PORT=8787
HOST=0.0.0.0

# Required when DEMO_MODE=0. Protects /admin (dashboard data, key creation). Use a long random value.
ADMIN_TOKEN=

# Official provider API keys (only used when DEMO_MODE=0). Providers without a key are skipped in routing.
# Consumer subscription accounts are not supported, and keys are never shared with teams: teams get virtual keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional. Without these the gateway keeps cache, counters and ledger in memory.
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway

# Per attempt timeout before falling back to the next provider (ms).
PROVIDER_TIMEOUT_MS=20000

# Exact cache: lifetime and scope (team = teams never share answers, global = shared).
CACHE_TTL_SECONDS=86400
CACHE_SCOPE=team

# Optional semantic cache for near duplicate prompts (in process memory in this build).
SEMANTIC_CACHE=0
SEMANTIC_CACHE_THRESHOLD=0.92

# Task classifier: rules (default, free) or llm (asks the cheapest model for a one word label).
# CLASSIFIER=rules

# Store the redacted prompt (never the raw one) in the ledger. Off by default.
AUDIT_STORE_REDACTED_PROMPTS=0

# Demo only: scales mock latency (0 = instant, 1 = realistic).
MOCK_LATENCY_SCALE=1

LOG_LEVEL=info

# Dashboard: where the gateway is (server side only; the browser never sees ADMIN_TOKEN).
GATEWAY_URL=http://localhost:8787
